{
  "name": "vehicle-matcher",
  "version": "0.1.0",
  "description": "Find My Perfect BMW — a UK car-matching quiz built as a portable Adobe EDS block",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "node scripts/serve.js",
    "preview": "python3 -m http.server 3000",
    "server": "node server/index.js",
    "audit": "node scripts/audit-questions.mjs",
    "build:motorrad-runtime": "node scripts/build-motorrad-derivative-catalogue.mjs",
    "check:motorrad-runtime": "node scripts/build-motorrad-runtime-catalogue.mjs --check",
    "audit:motorrad-resolver": "node scripts/build-motorrad-derivative-catalogue.mjs && node scripts/audit-motorrad-resolver-shadow.mjs",
    "audit:motorrad-proposed-scoring": "node scripts/audit-motorrad-scoring.mjs",
    "build:motorrad-scoring-runtime": "node scripts/build-motorrad-runtime-scoring-profiles.mjs",
    "check:motorrad-scoring-runtime": "node scripts/build-motorrad-runtime-scoring-profiles.mjs --check",
    "audit:motorrad-scoring": "node scripts/audit-motorrad-scoring.mjs && node scripts/build-motorrad-runtime-scoring-profiles.mjs && node scripts/audit-motorrad-scoring-production.mjs",
    "audit:motorrad-performance": "node scripts/audit-motorrad-performance-curve.mjs",
    "audit:motorrad-equipment": "node scripts/audit-motorrad-equipment.mjs",
    "audit:motorrad-segments": "node scripts/audit-motorrad-segments.mjs",
    "audit:motorrad-equipment-behaviour": "node scripts/audit-motorrad-equipment-enrichment.mjs",
    "audit:refine": "node scripts/audit-refinement.mjs",
    "personas": "node scripts/persona-check.mjs",
    "test": "node --test server/test/**/*.test.js"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
